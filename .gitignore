# Python virtual environments
.venv/
.venv_*/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Test / lint / type-check cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep

# Temporary 1C import/export working data
tmp/*
!tmp/.gitkeep
!tmp/one_c_raw/
!tmp/one_c_raw/.gitkeep
!tmp/one_c_staging/
!tmp/one_c_staging/.gitkeep

# OS / editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Local runtime files
*.log
*.pid

# Local 1C sandbox / disposable databases
local_sandbox/

# 1C / database / backup files must never be committed
*.1CD
*.dt
*.cf
*.bak
*.dump
*.sqlite
*.sqlite3
*.db

# v0.5 local OneC sandbox working paths
local_sandbox/
local_sandbox/one_c_databases/
local_sandbox/one_c_exports/
local_sandbox/one_c_tmp/
local_sandbox/one_c_working_copies/

# 1C / database / dump / backup files must not be committed
*.1CD
*.dt
*.cf
*.bak
*.dump
*.sqlite
*.sqlite3
*.db
*.mdb
*.accdb