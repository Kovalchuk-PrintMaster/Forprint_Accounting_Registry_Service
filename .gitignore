# Python virtual environments
.venv/
.venv_*/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Test / lint / type-check cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep

# Temporary 1C import/export working data
tmp/*
!tmp/.gitkeep
!tmp/one_c_raw/
!tmp/one_c_raw/.gitkeep
!tmp/one_c_staging/
!tmp/one_c_staging/.gitkeep

# OS / editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Local runtime files
*.log
*.pid